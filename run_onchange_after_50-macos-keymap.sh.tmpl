{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

# Ensure D-Bus session bus address is set for gsettings/dconf
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "/run/user/$(id -u)/bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

# 1. Unbind Super+V from GNOME message tray so Command+V never opens notifications
if command -v gsettings >/dev/null 2>&1; then
  echo "Disabling GNOME Super+V notification popup..."
  gsettings set org.gnome.shell.keybindings toggle-message-tray "[]" 2>/dev/null || true
  dconf write /org/gnome/shell/keybindings/toggle-message-tray "[]" 2>/dev/null || true

  echo "Configuring GNOME XKB options (Left Command <-> Left Control)..."
  gsettings set org.gnome.desktop.input-sources xkb-options "['ctrl:swap_lwin_lctrl']" 2>/dev/null || true
  dconf write /org/gnome/desktop/input-sources/xkb-options "['ctrl:swap_lwin_lctrl']" 2>/dev/null || true

  echo "Mapping Command+Space to GNOME Overview / Spotlight search..."
  gsettings set org.gnome.desktop.wm.keybindings switch-input-source "[]" 2>/dev/null || true
  gsettings set org.gnome.desktop.wm.keybindings switch-input-source-backward "[]" 2>/dev/null || true
  dconf write /org/gnome/desktop/wm/keybindings/switch-input-source "[]" 2>/dev/null || true

  gsettings set org.gnome.shell.keybindings toggle-overview "['<Super>space', '<Control>space', '<Super>s']" 2>/dev/null || true
  dconf write /org/gnome/shell/keybindings/toggle-overview "['<Super>space', '<Control>space', '<Super>s']" 2>/dev/null || true

  echo "Configuring Ubuntu Tiling Assistant with ShiftIt hotkeys (Ctrl+Alt+Cmd + Arrows / M)..."
  if command -v gnome-extensions >/dev/null 2>&1; then
    gnome-extensions enable tiling-assistant@ubuntu.com 2>/dev/null || true
  fi
  if gsettings list-schemas 2>/dev/null | grep -qx "org.gnome.shell.extensions.tiling-assistant"; then
    # Disable the modal window-picker popup when tiling so it behaves like ShiftIt
    gsettings set org.gnome.shell.extensions.tiling-assistant enable-tiling-popup false 2>/dev/null || true
    # Halves: Ctrl+Alt+Cmd + Left / Right / Up / Down
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-left-half "['<Control><Alt><Super>Left', '<Super>Left', '<Super>KP_4']" 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-right-half "['<Control><Alt><Super>Right', '<Super>Right', '<Super>KP_6']" 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-top-half "['<Control><Alt><Super>Up', '<Super>KP_8']" 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-bottom-half "['<Control><Alt><Super>Down', '<Super>KP_2']" 2>/dev/null || true
    # Maximize to full size: Ctrl+Alt+Cmd + M
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-maximize "['<Control><Alt><Super>m', '<Super>Up', '<Super>KP_5']" 2>/dev/null || true
    # Quarters & Center (ShiftIt 1/2/3/4 and C)
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-topleft-quarter "['<Control><Alt><Super>1', '<Super>KP_7']" 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-topright-quarter "['<Control><Alt><Super>2', '<Super>KP_9']" 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-bottomleft-quarter "['<Control><Alt><Super>3', '<Super>KP_1']" 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.tiling-assistant tile-bottomright-quarter "['<Control><Alt><Super>4', '<Super>KP_3']" 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.tiling-assistant center-window "['<Control><Alt><Super>c']" 2>/dev/null || true
  fi
  dconf write /org/gnome/shell/extensions/tiling-assistant/enable-tiling-popup "false" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-left-half "['<Control><Alt><Super>Left', '<Super>Left', '<Super>KP_4']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-right-half "['<Control><Alt><Super>Right', '<Super>Right', '<Super>KP_6']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-top-half "['<Control><Alt><Super>Up', '<Super>KP_8']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-bottom-half "['<Control><Alt><Super>Down', '<Super>KP_2']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-maximize "['<Control><Alt><Super>m', '<Super>Up', '<Super>KP_5']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-topleft-quarter "['<Control><Alt><Super>1', '<Super>KP_7']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-topright-quarter "['<Control><Alt><Super>2', '<Super>KP_9']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-bottomleft-quarter "['<Control><Alt><Super>3', '<Super>KP_1']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/tile-bottomright-quarter "['<Control><Alt><Super>4', '<Super>KP_3']" 2>/dev/null || true
  dconf write /org/gnome/shell/extensions/tiling-assistant/center-window "['<Control><Alt><Super>c']" 2>/dev/null || true
fi

# 2. Kernel-level key mapping via keyd (guarantees Cmd+C/Cmd+V across ALL apps & Wayland)
if ! command -v keyd >/dev/null 2>&1; then
  echo "Installing keyd for system-wide macOS key emulation..."
  if [ -f /etc/os-release ]; then
    . /etc/os-release
    if [ "$ID" = "debian" ] || [ "$ID" = "ubuntu" ]; then
      sudo apt-get update -y && sudo apt-get install -y keyd || true
    elif [ "$ID" = "arch" ]; then
      sudo pacman -S --noconfirm keyd || true
    fi
  fi
fi

if command -v keyd >/dev/null 2>&1; then
  echo "Configuring keyd for macOS Command <-> Control mapping..."
  sudo mkdir -p /etc/keyd
  cat << 'EOF' | sudo tee /etc/keyd/default.conf > /dev/null
[ids]
*

[main]
# Map Left Command (Meta) to Control for Cmd+C, Cmd+V, etc.
leftmeta = leftcontrol
leftcontrol = leftmeta
EOF
  sudo systemctl enable --now keyd 2>/dev/null || true
  sudo keyd reload 2>/dev/null || true
fi
{{- else -}}
#!/bin/sh
# Not Linux — skipping keyboard mapping configuration
{{- end -}}
