{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

HA_DIR="$HOME/home-assistant"

echo "Configuring Home Assistant via Docker Compose..."

# 1. Install Docker & Compose V2 plugin if not present
if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  echo "Installing Docker Engine and Docker Compose plugin..."
  if [ -f /etc/os-release ]; then
    . /etc/os-release
    if [ "$ID" = "debian" ] || [ "$ID" = "ubuntu" ]; then
      sudo apt-get update -y
      sudo apt-get install -y ca-certificates curl gnupg

      sudo install -m 0755 -d /etc/apt/keyrings
      if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
        curl -fsSL "https://download.docker.com/linux/$ID/gpg" | sudo gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
        sudo chmod a+r /etc/apt/keyrings/docker.gpg
      fi

      # Determine codename (fallback to noble for upcoming/unsupported Ubuntu releases)
      TARGET_CODENAME="${VERSION_CODENAME:-$UBUNTU_CODENAME}"
      if [ "$ID" = "ubuntu" ] && [ "$TARGET_CODENAME" != "noble" ] && [ "$TARGET_CODENAME" != "jammy" ] && [ "$TARGET_CODENAME" != "focal" ]; then
        TARGET_CODENAME="noble"
      fi

      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $TARGET_CODENAME stable" \
        | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

      sudo apt-get update -y
      sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

      # Add current user to docker group
      sudo usermod -aG docker "$USER" 2>/dev/null || true
      sudo systemctl enable --now docker 2>/dev/null || true
    elif [ "$ID" = "arch" ]; then
      sudo pacman -Syu --noconfirm --needed docker docker-compose
      sudo usermod -aG docker "$USER" 2>/dev/null || true
      sudo systemctl enable --now docker 2>/dev/null || true
    fi
  fi
fi

# 2. Create Home Assistant directory structure
mkdir -p "$HA_DIR/config"

# 3. Create docker-compose specification
cat << 'EOF' > "$HA_DIR/compose.yaml"
services:
  homeassistant:
    container_name: homeassistant
    image: ghcr.io/home-assistant/home-assistant:stable
    restart: unless-stopped
    privileged: true
    network_mode: host
    stop_grace_period: 60s
    volumes:
      - ./config:/config
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
EOF

# 4. Configure firewall (if UFW active)
if command -v ufw >/dev/null 2>&1 && sudo ufw status 2>/dev/null | grep -q "Status: active"; then
  echo "Opening port 8123 in UFW for Home Assistant..."
  sudo ufw allow 8123/tcp comment 'Home Assistant' 2>/dev/null || true
fi

# 5. Start Home Assistant container
echo "Starting Home Assistant container..."
DOCKER_CMD="docker compose"
if ! docker ps >/dev/null 2>&1; then
  DOCKER_CMD="sudo docker compose"
fi

$DOCKER_CMD -f "$HA_DIR/compose.yaml" up -d

# 6. Install HACS (Home Assistant Community Store)
HACS_DIR="$HA_DIR/config/custom_components/hacs"
if [ ! -d "$HACS_DIR" ]; then
  echo "Installing HACS (Home Assistant Community Store)..."
  mkdir -p "$HACS_DIR"
  if $DOCKER_CMD -f "$HA_DIR/compose.yaml" exec -T homeassistant wget -q -O - https://get.hacs.xyz 2>/dev/null | $DOCKER_CMD -f "$HA_DIR/compose.yaml" exec -T homeassistant bash 2>/dev/null; then
    echo "HACS installed via official container installer."
  else
    # Fallback to direct download of release zip
    HACS_URL=$(curl -s https://api.github.com/repos/hacs/integration/releases/latest | grep "browser_download_url.*hacs.zip" | cut -d : -f 2,3 | tr -d \")
    if [ -n "$HACS_URL" ]; then
      curl -fsSL "$HACS_URL" -o /tmp/hacs.zip
      unzip -q -o /tmp/hacs.zip -d "$HACS_DIR"
      rm -f /tmp/hacs.zip
    fi
  fi

  echo "Restarting Home Assistant container to load HACS..."
  $DOCKER_CMD -f "$HA_DIR/compose.yaml" restart
  echo "HACS files installed successfully."
fi

echo "Home Assistant successfully deployed in $HA_DIR!"
echo "Access the web UI at http://localhost:8123 or http://$(hostname -I 2>/dev/null | awk '{print $1}'):8123"
echo "To activate HACS: Go to Settings > Devices & Services > Add Integration and search for 'HACS'."
{{- else -}}
#!/bin/sh
# Not Linux — skipping Home Assistant Docker installation
{{- end -}}
