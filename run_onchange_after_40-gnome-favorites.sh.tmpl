{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

# Ensure D-Bus session bus address is set (required for gsettings/dconf over SSH or non-interactive shells)
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "/run/user/$(id -u)/bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

# Pin Ghostty, Firefox & GNOME System Settings to GNOME Dock favorite apps if GNOME Shell is present
if command -v gsettings >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  echo "Updating GNOME dock favorite apps (Ghostty, Firefox, Settings)..."
  python3 -c "
import subprocess, os, ast

def pin_app(favs, possible_names):
    for name in possible_names:
        if name in favs or any(name in str(item) for item in favs):
            return False
    for name in possible_names:
        if os.path.exists(f'/usr/share/applications/{name}') or os.path.exists(os.path.expanduser(f'~/.local/share/applications/{name}')):
            favs.append(name)
            return True
    favs.append(possible_names[0])
    return True

try:
    res = subprocess.run(['gsettings', 'get', 'org.gnome.shell', 'favorite-apps'], capture_output=True, text=True)
    fav_str = res.stdout.strip()
    if res.returncode == 0 and fav_str:
        favs = ast.literal_eval(fav_str)
        modified = False

        # Ghostty
        if pin_app(favs, ['com.mitchellh.ghostty.desktop', 'ghostty.desktop']):
            modified = True

        # Clean up stale snap firefox entry if present
        if 'firefox_firefox.desktop' in favs:
            favs = [item for item in favs if item != 'firefox_firefox.desktop']
            modified = True

        # Firefox
        if pin_app(favs, ['firefox.desktop']):
            modified = True

        # GNOME System Settings
        if pin_app(favs, ['org.gnome.Settings.desktop', 'gnome-control-center.desktop']):
            modified = True

        if modified:
            val = str(favs)
            res_set = subprocess.run(['gsettings', 'set', 'org.gnome.shell', 'favorite-apps', val], capture_output=True, text=True)
            if res_set.returncode != 0:
                subprocess.run(['dconf', 'write', '/org/gnome/shell/favorite-apps', val])
            print(f'Updated GNOME favorite apps: {favs}')
except Exception as e:
    print(f'Note: GNOME favorites update skipped ({e})')
" || true

  # Disable persistent update notifications from App Updates (snap-store), update-notifier, GNOME Software, and Firefox
  echo "Disabling update notification popups for Firefox, Snap, and App Center..."
  gsettings set com.ubuntu.update-notifier no-show-notifications true 2>/dev/null || true
  dconf write /com/ubuntu/update-notifier/no-show-notifications true 2>/dev/null || true

  gsettings set org.gnome.software download-updates-notify false 2>/dev/null || true
  gsettings set org.gnome.software download-updates false 2>/dev/null || true
  dconf write /org/gnome/software/download-updates-notify false 2>/dev/null || true
  dconf write /org/gnome/software/download-updates false 2>/dev/null || true

  for app in snap-store snap-store_snap-store snap-store_ubuntu-software update-notifier io-snapcraft-snap-store io-snapcraft-snapd snapd firefox firefox_firefox; do
    gsettings set "org.gnome.desktop.notifications.application:/org/gnome/desktop/notifications/application/$app/" enable false 2>/dev/null || true
    gsettings set "org.gnome.desktop.notifications.application:/org/gnome/desktop/notifications/application/$app/" show-banners false 2>/dev/null || true
    dconf write "/org/gnome/desktop/notifications/application/$app/enable" false 2>/dev/null || true
    dconf write "/org/gnome/desktop/notifications/application/$app/show-banners" false 2>/dev/null || true
  done
fi
{{- else -}}
#!/bin/sh
# Not Linux — skipping GNOME favorites configuration
{{- end -}}
